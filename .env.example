NODE_ENV=development
PORT=3000
SESSION_SECRET=troque-esta-chave-em-producao
APP_NAME=Supermercado Inteligente

# MySQL 8.4 LTS — banco transacional (OLTP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=supermercado_app
DB_PASSWORD=senha_local
DB_OLTP=supermercado_oltp

# Banco analítico (OLAP). Pode usar a mesma instância MySQL inicialmente.
DB_OLAP=supermercado_olap
DB_CONNECTION_LIMIT=10
DB_SSL=false

# IA: manter a chave somente no backend. Não preencher no repositório.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenTelemetry direto da aplicação Node.js para Grafana Cloud
OTEL_SERVICE_NAME=supermercado-inteligente
GRAFANA_CLOUD_OTLP_ENDPOINT=
# Valor Base64 de usuario:token (sem o prefixo "Basic ")
GRAFANA_CLOUD_OTLP_AUTH=
