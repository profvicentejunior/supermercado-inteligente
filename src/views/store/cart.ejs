<%- include('partials/header', { title }) %>

<section class="catalog-top">
  <span class="eyebrow">SUAS ESCOLHAS</span>
  <h1>Meu carrinho</h1>
  <p>Confira seus produtos antes de continuar.</p>
</section>

<section class="section cart-section">
  <% if (items.length) { %>
    <div class="cart-layout">
      <div class="cart-items">
        <% items.forEach(item => { %>
          <article class="cart-item">
            <div class="cart-product-icon">🛍️</div>
            <div class="cart-product-info">
              <strong><%= item.name %></strong>
              <small>R$ <%= item.price.toFixed(2).replace('.', ',') %> / <%= item.unit %></small>
              <form action="/loja/carrinho/atualizar" method="POST" class="quantity-form">
                <input type="hidden" name="product_id" value="<%= item.productId %>">
                <input type="number" name="quantity" min="1" max="99" value="<%= item.quantity %>" required>
                <button type="submit" class="update-button">Atualizar</button>
              </form>
            </div>
            <div class="cart-item-end">
              <strong>R$ <%= (item.price * item.quantity).toFixed(2).replace('.', ',') %></strong>
              <form action="/loja/carrinho/remover" method="POST">
                <input type="hidden" name="product_id" value="<%= item.productId %>">
                <button type="submit" class="remove-button">Remover</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
      <aside class="cart-summary">
        <h2>Resumo do pedido</h2>
        <div class="summary-line"><span>Produtos (<%= items.length %>)</span><strong>R$ <%= subtotal.toFixed(2).replace('.', ',') %></strong></div>
        <div class="summary-total"><span>Subtotal</span><strong>R$ <%= subtotal.toFixed(2).replace('.', ',') %></strong></div>
        <p class="summary-note">Frete e descontos serão calculados na finalização.</p>
        <a href="/loja/checkout" class="btn-main checkout-button">Continuar para checkout →</a>
        <a href="/loja/produtos" class="continue-link">← Continuar comprando</a>
      </aside>
    </div>
  <% } else { %>
    <div class="empty-state cart-empty">
      <div style="font-size:48px">🛒</div>
      <h2>Seu carrinho está vazio</h2>
      <p>Explore o catálogo e escolha seus produtos favoritos.</p>
      <a href="/loja/produtos" class="btn-main">Ver produtos →</a>
    </div>
  <% } %>
</section>

<style>
.cart-layout{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:start}.cart-items{display:grid;gap:12px}.cart-item{border:1px solid #e9eee8;border-radius:14px;padding:17px;display:flex;align-items:center;gap:16px}.cart-product-icon{width:58px;height:58px;background:#eff6ec;border-radius:12px;display:grid;place-items:center;font-size:27px}.cart-product-info{flex:1;display:grid;gap:7px}.cart-product-info small{color:#718078}.quantity-form{display:flex;gap:7px;align-items:center}.quantity-form input{width:65px;padding:7px;border:1px solid #dfe7df;border-radius:7px}.update-button,.remove-button{background:none;border:0;color:#176b45;font-weight:700;cursor:pointer}.cart-item-end{text-align:right;display:grid;gap:12px}.cart-item-end strong{white-space:nowrap}.remove-button{color:#a34e36}.cart-summary{border:1px solid #e9eee8;border-radius:15px;padding:22px;position:sticky;top:20px}.cart-summary h2{font:800 19px Manrope,sans-serif}.summary-line,.summary-total{display:flex;justify-content:space-between;padding:15px 0;border-bottom:1px solid #e9eee8;font-size:13px}.summary-total{font-size:16px;border:0}.summary-note{font-size:11px;color:#718078;line-height:1.5}.checkout-button{width:100%;justify-content:center;margin:10px 0}.continue-link{display:block;text-align:center;color:#176b45;font-size:12px;font-weight:700;margin-top:10px}.cart-empty{padding:55px 20px}.cart-empty h2{margin:14px 0 8px}.cart-empty p{margin-bottom:22px;color:#718078}@media(max-width:760px){.cart-layout{grid-template-columns:1fr}.cart-item{gap:9px;padding:12px}.cart-product-icon{width:42px;height:42px}.cart-product-info strong{font-size:12px}.cart-item-end strong{font-size:12px}}
</style>

<%- include('partials/footer') %>
