<%- include('../partials/header', {title}) %>
<div class="page-heading">
  <div><div class="eyebrow">OPERAÇÃO DA LOJA</div><h1>Gestão de pedidos</h1>
  <p>Acompanhe as vendas realizadas no portal do supermercado.</p></div>
  <span class="date-chip"><%= orders.length %> pedidos recentes</span>
</div>
<section class="panel">
  <div class="panel-head"><div><h2>Pedidos recebidos</h2><p>Últimos 100 pedidos registrados</p></div></div>
  <div class="table-responsive">
    <table class="table clean-table">
      <thead><tr><th>Pedido</th><th>Cliente</th><th>Data</th><th>Valor</th><th>Situação</th><th></th></tr></thead>
      <tbody>
      <% if (!orders.length) { %><tr><td colspan="6">Nenhum pedido encontrado.</td></tr><% } %>
      <% orders.forEach(o => { %>
        <tr>
          <td><strong><%= o.order_number %></strong></td>
          <td><%= o.customer_name || 'Cliente não informado' %></td>
          <td><%= o.created_at ? new Date(o.created_at).toLocaleString('pt-BR') : '—' %></td>
          <td>R$ <%= Number(o.total).toFixed(2).replace('.', ',') %></td>
          <td><span class="tag <%= o.status === 'COMPLETED' ? 'tag-success' : o.status === 'CANCELLED' ? 'tag-danger' : 'tag-warning' %>"><%= o.status %></span></td>
          <td><a href="/admin/orders/<%= o.id %>">Detalhes →</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
